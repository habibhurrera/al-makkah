# AL-MAKKAH REAL ESTATE - environment template
# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase Postgres -------------------------------------------------------
# Pooled connection (pgbouncer, port 6543) - used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) - used by prisma migrate only.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase project --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses row-level security - never expose to the browser,
# never prefix with NEXT_PUBLIC_, never paste into chat or a commit.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Storage buckets ---------------------------------------------------------
SUPABASE_BUCKET_MEDIA="property-media"
SUPABASE_BUCKET_DOCUMENTS="property-documents"
SUPABASE_BUCKET_SUBMISSIONS="submissions"

# --- Rate limiting (optional) ------------------------------------------------
# Without these, rate limits are counted in memory, per serverless instance -
# enough for form spam and double submits, not for a distributed attacker.
# Set both to share counters across every instance (Upstash Redis, REST API).
# GET /api/health reports which store is in use.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Lead notifications (optional) ----------------------------------------
# Email someone when an enquiry or property submission arrives. Unset means
# no email is sent - leads are always written to the database regardless, and
# are visible at /admin/leads. GET /api/health reports which mode is active.
RESEND_API_KEY=""
LEAD_NOTIFY_TO=""
# Optional. Must be a domain verified with the provider; defaults to the
# provider's shared sandbox sender, which is fine for testing only.
LEAD_NOTIFY_FROM=""

# --- Homepage hero (optional) ---------------------------------------------
# The hero film. Defaults to /hero/construction.mp4 and /hero/construction.jpg,
# rendered by the Remotion project (composition "HeroLoop").
# Override per deployment so a licensee can point at footage they own without
# touching code. Local paths, or a full URL on the project's own Supabase host -
# anything else is blocked by the media-src CSP directive.
NEXT_PUBLIC_HERO_VIDEO_URL=""
NEXT_PUBLIC_HERO_POSTER_URL=""

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
